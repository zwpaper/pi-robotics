<!--
  TidyBot++ task scene: water the plant.

  The robot picks up the watering can from the table and pours over the plant.
  MuJoCo does not simulate fluid, so the water inside the can is a translucent
  visual placeholder; the task is the manipulation motion.

  Load with:
    robotics { action: "load", path: "examples/tidybot2/models/stanford_tidybot/scene_water_plant.xml" }
-->
<mujoco model="tidybot water_plant scene">
  <include file="tidybot.xml"/>

  <statistic center="0.55 0 0.5" extent="1.0" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="table_mat" rgba="0.62 0.45 0.30 1"/>
    <material name="pot" rgba="0.72 0.34 0.24 1"/>
    <material name="soil" rgba="0.20 0.14 0.09 1"/>
    <material name="stem" rgba="0.25 0.5 0.2 1"/>
    <material name="leaf" rgba="0.30 0.62 0.26 1"/>
    <material name="can_metal" rgba="0.55 0.62 0.68 1"/>
    <material name="can" rgba="0.20 0.45 0.75 1"/>
    <material name="water" rgba="0.25 0.6 0.95 0.55"/>
  </asset>

  <worldbody>
    <light pos="0.4 0 2.0" dir="0 0 -1" directional="true"/>
    <camera name="work" pos="0.0200 -0.8000 1.0200" quat="0.8142 0.4953 -0.1575 -0.2588" fovy="45"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- workbench in front of the robot -->
    <body name="table" pos="0.62 0 0.19">
      <geom name="table_top" type="box" size="0.22 0.30 0.19" material="table_mat"/>
    </body>

    <!-- potted plant (fixed target on the table, left side) -->
    <body name="plant" pos="0.62 0.15 0.38">
      <geom name="pot" type="cylinder" size="0.05 0.055" pos="0 0 0.055" material="pot"/>
      <geom name="soil" type="cylinder" size="0.043 0.008" pos="0 0 0.112" material="soil"/>
      <geom name="stem" type="capsule" fromto="0 0 0.11 0 0 0.34" size="0.007" material="stem"/>
      <geom name="leaf0" type="capsule" fromto="0 0 0.17 0.10 0.02 0.22" size="0.012" material="leaf"/>
      <geom name="leaf1" type="capsule" fromto="0 0 0.21 -0.10 -0.03 0.26" size="0.012" material="leaf"/>
      <geom name="leaf2" type="capsule" fromto="0 0 0.25 0.06 0.09 0.31" size="0.012" material="leaf"/>
      <geom name="leaf3" type="capsule" fromto="0 0 0.29 -0.06 -0.08 0.34" size="0.011" material="leaf"/>
      <geom name="leaf4" type="capsule" fromto="0 0 0.13 -0.09 0.05 0.19" size="0.012" material="leaf"/>
    </body>

    <!-- watering can (free body the robot grasps) -->
    <body name="watering_can" pos="0.62 -0.12 0.38">
      <freejoint name="watering_can_free"/>
      <geom name="can_base" type="cylinder" size="0.065 0.008" pos="0 0 0.008" material="can" mass="0.08"
        friction="1.0 0.05 0.001"/>
      <geom name="can_body" type="cylinder" size="0.045 0.105" pos="0 0 0.11" material="can" mass="0.14"
        friction="1.0 0.05 0.001"/>
      <geom name="can_water" type="cylinder" size="0.038 0.060" pos="0 0 0.10" material="water"
        contype="0" conaffinity="0" mass="0"/>
      <geom name="can_spout" type="capsule" fromto="0.040 0 0.18 0.135 0 0.24" size="0.011" material="can_metal"
        mass="0.05"/>
      <geom name="can_handle" type="capsule" fromto="-0.05 0 0.21 -0.02 0 0.27" size="0.008" material="can_metal"
        mass="0.02"/>
    </body>
  </worldbody>
</mujoco>
