      <geom type="mesh" mesh="majong_1" class="mj_collision"/>
      <geom type="mesh" mesh="majong_2" class="mj_collision"/>
      <site name="site_tile_3_sou" pos="0 -0.004 0.01" size="0.008" rgba="1 0.2 0.2 0.6"/>
    </body>
