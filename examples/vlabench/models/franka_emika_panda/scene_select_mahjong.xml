      <site name="site_tray" pos="0 0 0.03" size="0.01" rgba="0.1 0.9 0.2 0.6"/>
    </body>

    <body name="tile_3_sou" pos="-0.300 0.06 0.825" euler="0 1.57 3.14">
      <freejoint name="tile_3_sou_free"/>
      <geom type="mesh" mesh="majong_0" material="mj_BASE" class="mj_visual" mass="0.01"/>
