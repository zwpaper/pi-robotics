<!--
  VLABench select_mahjong example scene (REAL VLABench assets).

  Franka Emika Panda from the VLABench repo (mounted on the table at
  [0,-0.4,0.78] euler [0,0,1.57] per VLABench/configs/robot_config.json), a work
  table, a tray, and a row of REAL VLABench mahjong tiles built from
  obj/meshes/mahjong/mahjong.xml (meshes majong_0/1/2 + the value_suite
  materials), the same way VLABench's Mahjong component builds them.

  VLABench instruction: "Pick up the mahjong of 3 sou" -> tile_3_sou into the tray.
  Requires the downloaded VLABench assets (obj/, scenes/) under examples/vlabench/.
-->
<mujoco model="vlabench select_mahjong">
  <include file="panda_mounted.xml"/>

  <compiler angle="radian" meshdir="assets" texturedir="assets"/>

  <statistic center="0 0 0.85" extent="0.9" meansize="0.03"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="mj_visual"><geom type="mesh" contype="0" conaffinity="0" group="2"/></default>
    <default class="mj_collision"><geom type="mesh" group="3" solref="0.001 1" solimp="0.998 0.998 0.001"/></default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop" rgba="0.62 0.45 0.30 1"/>
    <material name="tray" rgba="0.32 0.33 0.37 1"/>

    <material name="mj_BASE" specular="0.5" shininess="0.49000000699999996" rgba="0.007086 0.054078 0.000000 1.000000"/>
    <material name="mj_white" specular="0.5" shininess="0.49000000699999996" rgba="0.800000 0.800000 0.800000 1.000000"/>
    <texture type="2d" name="1_man" file="mahjong/output_image_0_0.png"/>
    <material name="1_man" texture="1_man" specular="0.5" shininess="0.249999987"/>
