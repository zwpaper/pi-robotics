<!--
  Example scene for pi-robotics.

  Load it with the robotics tool:
      { "action": "load", "path": "examples/scenes/peg_and_hole.xml" }

  A peg on a table and a matching hole block, useful for contact-rich
  insertion experiments. Edit the file, then `load` it again to hot-swap the
  model in the live panel.
-->
<mujoco model="peg_and_hole">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global azimuth="135" elevation="-25"/>
  </visual>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.82 1"/>

    <body name="table" pos="0 0 0.35">
      <geom type="box" size="0.45 0.35 0.02" rgba="0.55 0.42 0.3 1"/>
    </body>

    <body name="hole_block" pos="0.2 0 0.4">
      <geom type="box" size="0.08 0.08 0.03" rgba="0.3 0.5 0.7 1"/>
    </body>

    <body name="peg" pos="-0.15 0 0.5">
      <freejoint/>
      <geom type="cylinder" size="0.02 0.07" rgba="0.9 0.5 0.2 1"
            condim="6" friction="1 0.1 0.01"/>
    </body>

    <site name="goal" pos="0.2 0 0.45" size="0.01" rgba="0.1 0.9 0.2 1"
          type="sphere"/>
  </worldbody>
</mujoco>
