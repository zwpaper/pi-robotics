# Large example assets are stored with Git LFS.
# A clone needs `git lfs` installed; `git clone` then fetches them automatically
# (or run `git lfs pull`). Without git-lfs the files appear as pointer stubs.
examples/**/*.obj filter=lfs diff=lfs merge=lfs -text
examples/**/*.stl filter=lfs diff=lfs merge=lfs -text
examples/**/*.STL filter=lfs diff=lfs merge=lfs -text
examples/**/*.mtl filter=lfs diff=lfs merge=lfs -text
examples/**/*.msh filter=lfs diff=lfs merge=lfs -text
examples/**/*.png filter=lfs diff=lfs merge=lfs -text
examples/**/*.jpg filter=lfs diff=lfs merge=lfs -text
examples/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
