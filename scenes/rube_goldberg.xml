<mujoco model="rube_goldberg">
  <!-- A passive Rube Goldberg chain:
       ball rolls down ramp -> domino cascade -> seesaw lever ->
       rope over pulley pulls a drop hammer -> hammer strikes bell. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35"/>
    <global azimuth="110" elevation="-16" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>
  <default>
    <geom friction="1.0 0.05 0.001" condim="4" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <default class="wood"><geom rgba="0.72 0.5 0.28 1"/></default>
    <default class="metal"><geom rgba="0.6 0.63 0.7 1"/></default>
    <default class="brass"><geom rgba="0.90 0.72 0.22 1"/></default>
    <default class="ballc"><geom rgba="0.10 0.75 1.0 1" friction="1.2 0.06 0.001"/></default>
  </default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0.05 0.07 0.12"
             width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.22 0.26 0.32"
             rgb2="0.12 0.14 0.18" markrgb="0.75 0.75 0.78" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.12"/>
  </asset>

  <worldbody>
    <light pos="0 -2 4" dir="0 0.3 -1" directional="true"/>
    <camera name="overview" pos="0.10 -4.35 2.05" xyaxes="1 0 0 0 0.42 0.91" fovy="46"/>
    <geom name="floor" type="plane" size="7 7 0.1" material="grid" friction="1.0 0.05 0.001"/>

    <!-- ============ STAGE 1: inclined ramp + rolling ball ============ -->
    <!-- Invisible chase-cam carrier: the daemon glides this body along the
         leading edge of the action, so `chase` follows the whole chain. -->
    <body name="director" pos="-1.75 0 0.0" gravcomp="1">
      <freejoint name="director_free"/>
      <geom name="director_geom" type="sphere" size="0.012" rgba="0.2 0.8 1 0"
            contype="0" conaffinity="0" mass="0.0004"/>
      <camera name="chase" pos="-1.5 -0.6 0.90" xyaxes="0.330 -0.944 0 0.217 0.076 0.973" fovy="52"/>
    </body>
    <body name="ramp" pos="-1.5 0 0.30" euler="0 0.314 0">
      <geom class="wood" name="ramp_base" type="box" size="0.7 0.17 0.02"/>
      <geom class="wood" name="ramp_rail_l" type="box" size="0.7 0.02 0.055" pos="0 -0.15 0.055"/>
      <geom class="wood" name="ramp_rail_r" type="box" size="0.7 0.02 0.055" pos="0 0.15 0.055"/>
    </body>
    <body name="starter_ball" pos="-2.05 0 0.56">
      <freejoint name="starter_ball_free"/>
      <geom class="ballc" name="starter_ball_geom" type="sphere" size="0.06" density="1200"/>
    </body>

    <!-- ============ STAGE 2: domino chain (8 x 0.22 m, 0.09 m apart) ============ -->
    <body name="dom0" pos="0.020 0 0.11"><freejoint/>
      <geom class="wood" name="dom0_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom1" pos="0.110 0 0.11"><freejoint/>
      <geom class="wood" name="dom1_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom2" pos="0.200 0 0.11"><freejoint/>
      <geom class="wood" name="dom2_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom3" pos="0.290 0 0.11"><freejoint/>
      <geom class="wood" name="dom3_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom4" pos="0.380 0 0.11"><freejoint/>
      <geom class="wood" name="dom4_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom5" pos="0.470 0 0.11"><freejoint/>
      <geom class="wood" name="dom5_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom6" pos="0.560 0 0.11"><freejoint/>
      <geom class="wood" name="dom6_g" type="box" size="0.012 0.05 0.11" density="700"/></body>
    <body name="dom7" pos="0.650 0 0.11"><freejoint/>
      <geom class="wood" name="dom7_g" type="box" size="0.012 0.05 0.11" density="700"/></body>

    <!-- ============ STAGE 3: unequal-arm seesaw lever ============ -->
    <body name="lever_pivot" pos="1.05 0 0.05">
      <geom class="metal" type="box" size="0.03 0.03 0.035" pos="0 0 -0.015"/>
    </body>
    <body name="lever" pos="1.05 0 0.10">
      <joint name="lever_hinge" type="hinge" axis="0 1 0" range="-0.9 0.9" damping="0.01"/>
      <geom class="wood" name="lever_lblock" type="box" size="0.125 0.075 0.012" pos="-0.125 0 0" density="120"/>
      <geom class="metal" name="lever_rarm" type="box" size="0.300 0.03 0.008" pos="0.300 0 0" density="350"/>
      <site name="weight_att" pos="0.60 0 0.03" size="0.008"/>
    </body>

    <!-- ============ STAGE 4: post + pulley + rope ============ -->
    <body name="gantry" pos="0 0 0">
      <geom class="metal" name="post" type="box" size="0.025 0.025 0.475" pos="1.92 0.12 0.475"/>
      <geom class="metal" name="bracket" type="box" size="0.03 0.05 0.02" pos="1.92 0.07 0.95"/>
    </body>
    <body name="pulley" pos="1.92 0 0.95" euler="1.5708 0 0">
      <joint name="pulley_hinge" type="hinge" axis="0 0 1" damping="0.002"/>
      <geom class="metal" name="pulley_wheel" type="cylinder" size="0.07 0.018"/>
      <site name="pulley_side" pos="0 0.091 0" size="0.01"/>
    </body>

    <!-- ============ STAGE 5: drop hammer + bell ============ -->
    <body name="hammer" pos="2.25 0 0.42">
      <joint name="hammer_slide" type="slide" axis="0 0 1" range="-0.45 0" damping="0.03"/>
      <geom class="metal" name="hammer_head" type="box" size="0.03 0.045 0.03" density="150"/>
      <site name="hammer_att" pos="0 0 0.05" size="0.008"/>
    </body>
    <body name="bell" pos="2.25 0 0.0">
      <geom class="metal" name="bell_base" type="box" size="0.03 0.03 0.008" pos="0 0 0.008" rgba="0.45 0.45 0.5 1"/>
      <geom class="brass" name="bell_geom" type="cylinder" size="0.055 0.12" pos="0 0 0.12"/>
      <geom class="brass" name="bell_cap" type="sphere" size="0.055" pos="0 0 0.24"/>
    </body>
  </worldbody>

  <tendon>
    <spatial name="rope" width="0.006" rgba="0.85 0.8 0.55 1" limited="true" range="0 1.6093">
      <site site="hammer_att"/>
      <geom geom="pulley_wheel" sidesite="pulley_side"/>
      <site site="weight_att"/>
    </spatial>
  </tendon>
</mujoco>
